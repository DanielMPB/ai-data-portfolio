# NEXUS V2 — variáveis de ambiente (copie para .env e ajuste)

# ---- LLM (Gemma) — cliente OpenAI-compatible ----
# Ollama local (default):    http://localhost:11434/v1
# Google AI (OpenAI-compat): https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma

# ---- Caminhos de dados ----
DADOS_BRUTOS_DIR=Dados Brutos
DADOS_PROCESSADOS_DIR=dados_processados

# ---- Servidor ----
API_HOST=127.0.0.1
API_PORT=8000
